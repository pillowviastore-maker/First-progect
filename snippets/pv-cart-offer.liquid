{% comment %} Buy 2, Get 1 FREE (3 for $71.99) progress message for the cart. {% endcomment %}
{%- liquid
  assign pv_qty = 0
  assign pv_variant = blank
  for item in cart.items
    if item.product.handle == 'pillowvia-ergonomic-cervical-pillow'
      assign pv_qty = pv_qty | plus: item.quantity
      assign pv_variant = item.variant_id
    endif
  endfor
  assign pv_rem = pv_qty | modulo: 3
-%}
{%- if pv_qty > 0 -%}
  <div class="pv-cart-offer{% if pv_rem == 0 %} pv-cart-offer--done{% endif %}">
    {%- if pv_rem == 0 -%}
      <p class="pv-cart-offer__text">🎉 <strong>Buy 2, Get 1 FREE applied — 3 for $71.99!</strong></p>
    {%- elsif pv_rem == 1 -%}
      <p class="pv-cart-offer__text">🎁 <strong>Buy 2, Get 1 FREE</strong> — add 2 more and get <strong>3 for $71.99!</strong></p>
    {%- else -%}
      <p class="pv-cart-offer__text">💡 <strong>Upgrade your deal:</strong> switch to <strong>Buy 2, Get 1 FREE</strong> — 3 pillows for <strong>$71.99</strong>, only <strong>$12 more</strong> and you save more!</p>
    {%- endif -%}
    <div class="pv-cart-offer__bar" aria-hidden="true">
      <span style="width: {% if pv_rem == 0 %}100{% else %}{{ pv_rem | times: 100 | divided_by: 3 }}{% endif %}%"></span>
    </div>
    {%- if pv_rem != 0 -%}
      {%- assign pv_need = 3 | minus: pv_rem -%}
      <button type="button" class="pv-cart-offer__btn" data-pv-add-bundle data-variant="{{ pv_variant }}" data-qty="{{ pv_need }}">
        {%- if pv_need == 1 -%}⬆️ Upgrade to 3 for $71.99{%- else -%}🎁 Add 2 more — get 1 FREE{%- endif -%}
      </button>
    {%- endif -%}
  </div>
{%- endif -%}
