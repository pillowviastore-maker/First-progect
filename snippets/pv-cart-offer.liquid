{% comment %} Buy 2, Get 1 FREE progress message for the cart. {% endcomment %}
{%- liquid
  assign pv_qty = 0
  for item in cart.items
    if item.product.handle == 'pillowvia-ergonomic-cervical-pillow'
      assign pv_qty = pv_qty | plus: item.quantity
    endif
  endfor
  assign pv_rem = pv_qty | modulo: 3
-%}
{%- if pv_qty > 0 -%}
  <div class="pv-cart-offer{% if pv_rem == 0 %} pv-cart-offer--done{% endif %}">
    {%- if pv_rem == 0 -%}
      <p class="pv-cart-offer__text">🎉 <strong>Your FREE pillow has been applied!</strong></p>
    {%- elsif pv_rem == 1 -%}
      <p class="pv-cart-offer__text">🎁 <strong>Buy 2, Get 1 FREE</strong> — add 2 more pillows and one is on us!</p>
    {%- else -%}
      <p class="pv-cart-offer__text">🎁 Add <strong>1 more pillow</strong> — it's <strong>FREE!</strong></p>
    {%- endif -%}
    <div class="pv-cart-offer__bar" aria-hidden="true">
      <span style="width: {% if pv_rem == 0 %}100{% else %}{{ pv_rem | times: 100 | divided_by: 3 }}{% endif %}%"></span>
    </div>
  </div>
{%- endif -%}
