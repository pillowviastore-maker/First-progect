{% comment %} Trust row and payment icons under the checkout button. {% endcomment %}
<div class="pv-cart-trust">
  <ul class="pv-cart-trust__list" role="list">
    <li>🔒 Secure checkout</li>
    <li>🚚 Free US shipping</li>
    <li>↩️ 100-night trial</li>
  </ul>
  {%- if shop.enabled_payment_types.size > 0 -%}
    <ul class="pv-cart-trust__pay" role="list">
      {%- for type in shop.enabled_payment_types -%}
        <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
