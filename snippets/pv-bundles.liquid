{% comment %}
  Quantity bundle picker (1 / 2 at a bundle price / 3 with one free). Sets the product form quantity.
  Accepts: block, form_id
{% endcomment %}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign unit = v.price
  assign unit_compare = v.compare_at_price | default: v.price
  assign default_qty = block.settings.default_qty | plus: 0
-%}
<div class="pv-bundles" data-pv-bundles data-form-id="{{ form_id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <p class="pv-bundles__heading"><span>{{ block.settings.heading }}</span></p>
  {%- endif -%}
  {%- for i in (1..3) -%}
    {%- if i == 2 and block.settings.show_option_2 == false -%}{%- continue -%}{%- endif -%}
    {%- liquid
      case i
        when 1
          assign qty = 1
          assign paid = 1
          assign title = block.settings.title_1
          assign sub = block.settings.sub_1
          assign badge = ''
        when 2
          assign qty = 2
          assign paid = 2
          assign title = block.settings.title_2
          assign sub = block.settings.sub_2
          assign badge = block.settings.badge_2
        when 3
          assign qty = 3
          assign paid = 2
          assign title = block.settings.title_3
          assign sub = block.settings.sub_3
          assign badge = block.settings.badge_3
      endcase
      assign total = unit | times: paid
      if i == 2 and block.settings.price_2 != blank
        assign total = block.settings.price_2 | times: 100 | round
      endif
      if i == 3 and block.settings.price_3 != blank
        assign total = block.settings.price_3 | times: 100 | round
      endif
      assign was = unit_compare | times: qty
      assign saved = was | minus: total
    -%}
    <label class="pv-bundle{% if i == 3 %} pv-bundle--best{% elsif i == 2 %} pv-bundle--popular{% endif %}">
      <input type="radio" name="pv-bundle-{{ section.id }}" value="{{ qty }}" data-total="{{ total | money | escape }}"{% if qty == default_qty %} checked{% endif %}>
      {%- if badge != blank -%}<span class="pv-bundle__badge">{{ badge }}</span>{%- endif -%}
      <span class="pv-bundle__radio" aria-hidden="true"></span>
      <span class="pv-bundle__info">
        <span class="pv-bundle__title">{{ title }}</span>
        {%- if sub != blank -%}<span class="pv-bundle__sub">{{ sub }}</span>{%- endif -%}
      </span>
      <span class="pv-bundle__prices">
        <span class="pv-bundle__price">{{ total | money }}</span>
        {%- if saved > 0 -%}<s class="pv-bundle__was">{{ was | money }}</s>{%- endif -%}
      </span>
    </label>
  {%- endfor -%}
  {%- if product.has_only_default_variant == false -%}
    <div class="pv-bundle-colors" data-pv-colors hidden>
      <p class="pv-bundle-colors__title">Choisissez une couleur pour chaque oreiller</p>
      {%- for n in (1..3) -%}
        <div class="pv-bundle-colors__row" data-pv-color-row data-n="{{ n }}">
          <span class="pv-bundle-colors__label">Oreiller {{ n }}{% if n == 3 %} <em>OFFERT 🎁</em>{% endif %}</span>
          <span class="pv-bundle-colors__opts">
            {%- for variant in product.variants -%}
              <label class="pv-color-pill{% unless variant.available %} is-disabled{% endunless %}">
                <input type="radio" name="pv-color-{{ section.id }}-{{ n }}" value="{{ variant.id }}"{% if variant.id == v.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                <span>{{ variant.title | escape }}</span>
              </label>
            {%- endfor -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  <input type="hidden" name="quantity" value="{{ default_qty }}" form="{{ form_id }}" data-pv-qty>
</div>
