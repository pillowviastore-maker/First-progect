{% comment %}
  Delivery estimate box. Dates are computed in the browser from business-day ranges.
  Accepts: block
{% endcomment %}
<div class="pv-delivery" {{ block.shopify_attributes }} data-min="{{ block.settings.min_days }}" data-max="{{ block.settings.max_days }}">
  <span class="pv-delivery__icon" aria-hidden="true">
    <svg viewBox="0 0 48 32" width="48" height="32"><path fill="currentColor" d="M2 4h26v18H2zM30 10h9l7 7v5h-16z"/><circle cx="10" cy="25" r="5" fill="currentColor" stroke="#E8EEFA" stroke-width="2.5"/><circle cx="37" cy="25" r="5" fill="currentColor" stroke="#E8EEFA" stroke-width="2.5"/></svg>
  </span>
  <div>
    <p class="pv-delivery__heading">{{ block.settings.heading }}</p>
    <p class="pv-delivery__text">{{ block.settings.text }}: <strong data-pv-dates>{{ block.settings.min_days }}–{{ block.settings.max_days }} business days</strong></p>
  </div>
</div>
<script>
  (function () {
    var box = document.currentScript.previousElementSibling;
    if (!box || !box.dataset.min) return;
    function addBusinessDays(date, days) {
      var d = new Date(date);
      while (days > 0) {
        d.setDate(d.getDate() + 1);
        if (d.getDay() !== 0 && d.getDay() !== 6) days--;
      }
      return d;
    }
    var fmt = { month: 'short', day: 'numeric' };
    var now = new Date();
    var from = addBusinessDays(now, parseInt(box.dataset.min, 10)).toLocaleDateString('en-US', fmt);
    var to = addBusinessDays(now, parseInt(box.dataset.max, 10)).toLocaleDateString('en-US', fmt);
    box.querySelector('[data-pv-dates]').textContent = from + ' – ' + to;
  })();
</script>
