{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="pv-track">
      <span class="pv-track__icon" aria-hidden="true">📦</span>
      <h1 class="pv-h pv-section-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="pv-track__text rte">{{ section.settings.text }}</div>{%- endif -%}
      <form class="pv-track__form" data-pv-track>
        <label class="visually-hidden" for="PvTrack-{{ section.id }}">Numéro de suivi</label>
        <input id="PvTrack-{{ section.id }}" class="pv-track__input" type="text" name="tracking" required autocomplete="off"
               placeholder="{{ section.settings.placeholder | escape }}">
        <button type="submit" class="pv-track__btn">{{ section.settings.button_label }}</button>
      </form>
      <p class="pv-track__error" data-pv-track-error hidden>Veuillez saisir votre numéro de suivi.</p>
      <ol class="pv-track__steps">
        <li><strong>Commande passée</strong><span>Préparée sous 1 à 3 jours ouvrés</span></li>
        <li><strong>Expédiée</strong><span>Numéro de suivi envoyé par e-mail</span></li>
        <li><strong>Livrée</strong><span>Généralement en 7 à 15 jours ouvrés</span></li>
      </ol>
      <p class="pv-track__help">
        Pas encore reçu l'e-mail de suivi ? <a href="{{ routes.account_url }}">Connectez-vous pour voir vos commandes</a> ou écrivez-nous à
        <a href="mailto:{{ shop.email }}">{{ shop.email }}</a> en indiquant votre numéro de commande.
      </p>
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.currentScript.previousElementSibling.querySelector('[data-pv-track]');
    if (!form) return;
    var err = form.parentNode.querySelector('[data-pv-track-error]');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var num = form.tracking.value.replace(/[^A-Za-z0-9,]/g, '');
      if (!num) { err.hidden = false; return; }
      err.hidden = true;
      window.open('https://t.17track.net/fr#nums=' + encodeURIComponent(num), '_blank', 'noopener');
    });
  })();
</script>

{% schema %}
{
  "name": "Track order",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track Your Order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Enter the tracking number from your shipping email.</p>" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "e.g. LP00123456789CN" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Track" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [{ "name": "Track order" }]
}
{% endschema %}
