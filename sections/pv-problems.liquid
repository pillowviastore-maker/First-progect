{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="pv-section__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="h2 inline-richtext">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="pv-section__subheading inline-richtext">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="pv-grid pv-grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="pv-card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
          <h3 class="pv-card__title h4">
            {%- if block.settings.icon != 'none' -%}
              <span class="pv-card__icon">{%- render 'icon-accordion', icon: block.settings.icon -%}</span>
            {%- endif -%}
            {{ block.settings.title }}
          </h3>
          {%- if block.settings.cause != blank -%}
            <p class="pv-card__label">{{ section.settings.cause_label }}</p>
            <div class="rte">{{ block.settings.cause }}</div>
          {%- endif -%}
          {%- if block.settings.solution != blank -%}
            <p class="pv-card__label pv-card__label--solution">{{ section.settings.solution_label }}</p>
            <div class="rte">{{ block.settings.solution }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Problems & solutions",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "cause_label",
      "label": "Cause label",
      "default": "The cause"
    },
    {
      "type": "text",
      "id": "solution_label",
      "label": "Solution label",
      "default": "How Pillowvia helps"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "check_mark",
              "label": "Check mark"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "lightning_bolt",
              "label": "Lightning bolt"
            },
            {
              "value": "snowflake",
              "label": "Snowflake"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "silhouette",
              "label": "Silhouette"
            },
            {
              "value": "stopwatch",
              "label": "Stopwatch"
            },
            {
              "value": "eye",
              "label": "Eye"
            },
            {
              "value": "chat_bubble",
              "label": "Chat bubble"
            },
            {
              "value": "return",
              "label": "Return"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "ruler",
              "label": "Ruler"
            },
            {
              "value": "washing",
              "label": "Washing"
            },
            {
              "value": "price_tag",
              "label": "Price tag"
            },
            {
              "value": "question_mark",
              "label": "Question mark"
            },
            {
              "value": "plant",
              "label": "Plant"
            },
            {
              "value": "box",
              "label": "Box"
            }
          ],
          "default": "check_mark"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Neck pain"
        },
        {
          "type": "richtext",
          "id": "cause",
          "label": "Cause",
          "default": "<p>Describe what causes the problem.</p>"
        },
        {
          "type": "richtext",
          "id": "solution",
          "label": "Solution",
          "default": "<p>Describe how the product helps.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Problems & solutions",
      "blocks": [
        {
          "type": "problem"
        },
        {
          "type": "problem"
        },
        {
          "type": "problem"
        }
      ]
    }
  ]
}
{% endschema %}
