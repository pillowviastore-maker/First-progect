{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign rating_sum = 0
  assign rated_count = 0
  for block in section.blocks
    if block.settings.rating > 0
      assign rating_sum = rating_sum | plus: block.settings.rating
      assign rated_count = rated_count | plus: 1
    endif
  endfor
  if rated_count > 0
    assign rating_avg = rating_sum | times: 10 | divided_by: rated_count | divided_by: 10.0 | round: 1
  endif
-%}
<div id="reviews" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pv-reviews-head">
      {%- if section.settings.eyebrow != blank -%}<p class="pv-reviews-head__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}
      <h2 class="pv-h pv-section-title inline-richtext">{{ section.settings.heading }}</h2>
    {%- endif -%}
      {%- if section.settings.score != blank -%}{%- assign rating_avg = section.settings.score -%}{%- endif -%}
      {%- if rated_count > 0 or section.settings.score != blank -%}
        <p class="pv-reviews-head__score"><strong>{{ rating_avg }}</strong>/5 <span class="pv-stars" aria-hidden="true">★★★★★</span></p>
      {%- endif -%}
    </div>
    <div class="pv-carousel" data-pv-carousel>
      <button type="button" class="pv-carousel__btn pv-carousel__btn--prev" data-pv-prev aria-label="Previous reviews">‹</button>
      <ul class="pv-carousel__track pv-reviews" role="list">
        {%- for block in section.blocks -%}
          <li class="pv-review" {{ block.shopify_attributes }}>
            <div class="pv-review__top">
              <span class="pv-avatar pv-avatar--{{ forloop.index | modulo: 5 }}">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', width: 60, height: 60, alt: block.settings.author }}
              {%- else -%}
                {{ block.settings.author | slice: 0 }}
              {%- endif -%}
            </span>
              <div>
                {%- if block.settings.rating > 0 -%}
                  <p class="pv-review__stars" aria-label="{{ block.settings.rating }} out of 5">
                    {%- for i in (1..5) -%}<span class="{% if i > block.settings.rating %}pv-star-off{% endif %}" aria-hidden="true">★</span>{%- endfor -%}
                    <strong>{{ block.settings.rating }}/5</strong>
                  </p>
                {%- endif -%}
                <p class="pv-review__author">{{ block.settings.author }}</p>
              </div>
            </div>
            {%- if block.settings.title != blank -%}<p class="pv-review__title">{{ block.settings.title }}</p>{%- endif -%}
            <div class="pv-review__text" data-pv-clamp>{{ block.settings.text }}</div>
            <button type="button" class="pv-review__more" data-pv-more hidden>Read more</button>
          </li>
        {%- endfor -%}
      </ul>
      <button type="button" class="pv-carousel__btn pv-carousel__btn--next" data-pv-next aria-label="Next reviews">›</button>
    </div>
    {%- if section.settings.source_note != blank -%}
      <p class="pv-note">{{ section.settings.source_note }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Reviews carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap words in italics to color them in the accent color."
    },
    {
      "type": "text",
      "id": "score",
      "label": "Rating shown (e.g. 4.8). Empty = average of reviews below"
    },
    {
      "type": "text",
      "id": "source_note",
      "label": "Source note",
      "info": "Say where these reviews come from, e.g. a partner store."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo (optional)"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Rating (0 = hide stars)",
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Review text",
          "default": "<p>Review text.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
